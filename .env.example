# ==============================================================================
# NEXUS OBE Portal — Environment Template
# Salin menjadi `.env.local` untuk development lokal, atau isi di Vercel:
# Project Settings -> Environment Variables (Production & Preview).
# JANGAN PERNAH commit `.env.local` atau mengisi secret asli di file ini!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain Aplikasi (Wajib)
# - Lokal       : http://localhost:3000
# - Produksi    : https://hananuttt.my.id
# Daftarkan URL callback berikut di Supabase Auth -> URL Configuration:
#   - https://hananuttt.my.id/api/auth/callback
#   - https://hananuttt.my.id/auth/confirm
#   - http://localhost:3000/api/auth/callback
#   - http://localhost:3000/auth/confirm
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hananuttt.my.id

# ------------------------------------------------------------------------------
# 2. Supabase (Wajib — ambil dari Supabase Dashboard -> Settings -> API Keys)
# Contoh URL: https://<project-ref>.supabase.co
# Catatan Google OAuth:
#   - Aktifkan Provider Google di Supabase Auth -> Providers -> Google
#   - Daftarkan Authorized redirect URI di Google Cloud Console:
#     https://<project-ref>.supabase.co/auth/v1/callback
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Keamanan Server & Vercel Cron (Wajib, minimal 32 karakter acak)
# Generate di terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
CRON_SECRET=
LOGIN_RATE_LIMIT_SECRET=

# ------------------------------------------------------------------------------
# 4. Pengiriman Email & OTP via Resend (Sangat disarankan untuk produksi)
# Contoh RESEND_FROM_EMAIL: NEXUS OBE <noreply@hananuttt.my.id>
# Jika diisi (domain hananuttt.my.id terverifikasi di Resend), OTP login &
# reset kata sandi dikirim langsung ke email pengguna melalui Resend;
# jika kosong, sistem otomatis memakai SMTP bawaan/kustom Supabase Auth.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 5. Web Push Notification (Opsional — generate: npx web-push generate-vapid-keys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hananuttt.my.id

# ==============================================================================
# NEXUS OBE Portal — Environment Template
# Salin menjadi `.env.local` untuk development lokal, atau isi di Vercel:
# Project Settings -> Environment Variables (Production & Preview).
# JANGAN PERNAH commit `.env.local` atau mengisi secret asli di file ini!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain Aplikasi (Wajib)
# - Lokal       : http://localhost:3000
# - Produksi    : https://hananuttt.my.id
# Daftarkan URL callback berikut di Supabase Auth -> URL Configuration:
#   - https://hananuttt.my.id/api/auth/callback
#   - https://hananuttt.my.id/auth/confirm
#   - http://localhost:3000/api/auth/callback
#   - http://localhost:3000/auth/confirm
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hananuttt.my.id

# ------------------------------------------------------------------------------
# 2. Supabase (Wajib — ambil dari Supabase Dashboard -> Settings -> API Keys)
# Contoh URL: https://<project-ref>.supabase.co
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Google Sign-In (Client ID Google)
# Isi Client ID Web dari Google Cloud Console agar tombol Google langsung aktif:
#   - Authorized JavaScript origins:
#       https://hananuttt.my.id
#       http://localhost:3000
#   - Authorized redirect URIs (untuk fallback OAuth Supabase):
#       https://<project-ref>.supabase.co/auth/v1/callback
# Masukkan Client ID yang sama pada Supabase -> Authentication -> Providers -> Google.
# (Jangan pernah menaruh Google Client Secret di sini; simpan hanya di Supabase Dashboard.)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. Keamanan Server & Vercel Cron (Wajib, minimal 32 karakter acak)
# Generate di terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
CRON_SECRET=
LOGIN_RATE_LIMIT_SECRET=

# ------------------------------------------------------------------------------
# 5. Google SMTP (Gmail App Password — direkomendasikan untuk OTP & Email)
# Cara buat App Password Gmail:
#   Google Account -> Security -> 2-Step Verification -> App passwords
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=465
#   - SMTP_USER=alamatgmailanda@gmail.com
#   - SMTP_PASS=16-karakter-app-password-google
#   - SMTP_FROM=NEXUS OBE <alamatgmailanda@gmail.com>
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------------------
# 6. Resend (Alternatif opsional jika tidak memakai Google SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 7. Web Push Notification (Opsional — generate: npx web-push generate-vapid-keys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hananuttt.my.id
